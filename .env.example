# ---- Giveaway settings ----
MAX_WRONG_ATTEMPTS=3
LOCK_HOURS=24
SEND_RATE=20
# true = Enter Code se pehle task channel join check (bot ko task channel me admin banana hoga)
REQUIRE_JOIN=false
# entries = sirf jinhone code daala unhe winner-message | all = bot ke sabhi users ko
WINNER_NOTIFY=entries

# ---- Growth features ----
REFERRAL_TICKETS=1
MAX_BONUS_TICKETS=20
MAX_SPONSORS=5
# true = winner declare hone par task channel me proof post (bot ko channel me admin banana hoga)
POST_WINNER_TO_CHANNEL=true

# ---- v3: Wallet / Invite / Leaderboard ----
# Har valid refer par kitne rupaye (paisa referrer ke balance me jata hai)
REF_REWARD_RS=0.20
# Kam se kam kitna balance hone par withdraw request ho sakti hai
MIN_WITHDRAW_RS=50
# Weekly leaderboard prize (top 1, top 2, top 3) — har Sunday 00:00 IST ko auto add
LB_PRIZES_RS=15,10,5
# Prize ke liye us hafte ke kam se kam itne refers chahiye
LB_MIN_REFS=10
# About screen me dikhne wala group link
GROUP_LINK=https://t.me/+DeGNFAXMuIg0MTk9
# Giveaway result post me max kitne participant naam dikhein (baaki "+N aur")
RESULT_MAX_NAMES=300
# Blocked/deleted winner ke badle max kitne naye winner try hon
REPLACE_TRIES=8

# ---- v4: Ledger / Anti-fraud / Bharosa (sab optional — default set hain) ----
# Admins (comma separated Telegram IDs). Withdraw card sabko jata hai, jo pehle Paid/Reject dabaye uska record.
# ADMIN_ID (main/owner) hamesha shamil hota hai; giveaway/broadcast jaisa owner panel sirf ADMIN_ID ka hai.
ADMINS=
# Invite code sirf itne ghante tak naye user laga sakte hain
INVITE_MAX_AGE_HOURS=48
# Ek din me galat invite code ki limit, phir INVITE_BLOCK_HOURS ka block
INVITE_MAX_WRONG=5
INVITE_BLOCK_HOURS=24
# Refer paisa tab pakka jab dost itne din channel me rahe (tab tak "pending")
REF_MATURE_DAYS=3
# Itne refers itne minute me aayein to fraud flag + admin alert (paisa ruk jata hai)
REF_BURST_COUNT=8
REF_BURST_WINDOW_MIN=10
# Adhoora dost (verify/join baaki) ko itne ghante baad ek baar DM yaad dilana
REF_NUDGE_HOURS=24
# Payment proof is channel par post hota hai (khaali = TASK_CHANNEL_ID). Bot wahan admin ho.
PROOF_CHANNEL_ID=
# Withdraw par user ko dikhne wala expected time
WD_ETA_TEXT=24-48 ghante
# Problem report: ek user ghante me max itne
REPORT_PER_HOUR=3
# (Video / image links ab env me nahi — bot.py ke upar ENTRY_VIDEO_URL, DROP_VIDEO_URL, BOT_VIDEO_URL, WELCOME_IMAGE_URL me daalo)
# Channel par auto post: har itne ghante me ek alag topic (giveaway, kaise use karein, leaderboard, drop, kamai ke tarike, streak, winners, refer, chance...)
AUTOPOST=true
AUTOPOST_HOURS=12
# true = naya auto post aate hi pichhla hata do (channel saaf rahta hai)
AUTOPOST_DELETE_OLD=true
